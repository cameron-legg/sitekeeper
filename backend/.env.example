DATABASE_URL=postgresql://sitekeeper:sitekeeper@localhost:5434/sitekeeper
JWT_SECRET=change-me
JWT_EXPIRY_SECONDS=8640000
CORS_ORIGINS=*

# Multi-tenant settings
BASE_DATABASE_URL=postgresql://sitekeeper:sitekeeper@localhost:5434
TENANTS_FILE=tenants.json
DEFAULT_TENANT=default

# Platform database (sk_platform) — control-plane for tenant management portal
# If unset, portal features are disabled and tenant resolution falls back to tenants.json
PLATFORM_DATABASE_URL=postgresql://sitekeeper:sitekeeper@localhost:5434/sk_platform

# Landing mode — set to true in production so the bare domain shows the
# public landing page instead of a tenant app. Leave false for local dev.
LANDING_MODE=false

# MinIO (S3-compatible blob storage for PDFs)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sitekeeper-pdfs
MINIO_USE_SSL=false

# OpenAI (for AI assistant features)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
