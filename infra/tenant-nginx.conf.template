# Nginx config for tenant: TENANT_NAME
# Domain: DOMAIN
# Generated by manage-tenant.sh — do not edit manually

server {
    listen 80;
    server_name DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name DOMAIN;

    # Wildcard cert covers all *.entouch.org subdomains
    ssl_certificate /etc/letsencrypt/live/entouch.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/entouch.org/privkey.pem;

    # API routes → backend container
    location /api/ {
        proxy_pass http://127.0.0.1:API_PORT;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Everything else → frontend container (static SPA)
    location / {
        proxy_pass http://127.0.0.1:FRONTEND_PORT;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
