# Flask API base URL — used by the Axios client in src/api/client.ts
#
# Use your machine's LAN IP (not localhost) when testing on a physical
# device via Expo Go — the phone can't resolve "localhost" to your machine.
#
# Find your LAN IP:
#   Linux/macOS: ip route get 1.1.1.1 | awk '{print $7; exit}'
#   Windows:     ipconfig | findstr "IPv4"
#
# Examples:
#   Physical device (Expo Go):  http://192.168.1.x:5000
#   Android emulator:           http://10.0.2.2:5000
#   Web browser (same machine): http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
